# Ignorar bases de dados locais e arquivos brutos volumosos
# O trabalho exige que a carga baixe os dados sob demanda ou use cache local não versionado
base-dados/*.csv
base-dados/*.zip
*.csv
*.zip
*.parquet

# Volumes do Docker / Dados persistidos do banco e lakehouse
postgres_data/
pgdata/
lakehouse/

# Python / Ambientes virtuais
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# Sistema operacional
.DS_Store
Thumbs.db

# Site gerado pelo MkDocs
site/

# E3 — artefatos locais
dbt_ceap/target/
dbt_ceap/logs/
dbt_ceap/dbt_packages/
orquestracao/.dagster_home/
orquestracao/.tmp_dagster_home_*/
logs/
dbt_ceap/.user.yml
# Seeds do dbt são regras de domínio versionadas, não dados brutos (exceção ao *.csv acima)
!dbt_ceap/seeds/*.csv